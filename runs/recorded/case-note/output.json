  "hypotheses": [
    {
      "id": "h1",
      "statement": "Because one device, D-568, sent every onward hop from A-9278 through A-5092 and A-2897 within minutes, a single operator may control those three accounts. That would fit a collection-and-layering (mule) pattern ending at A-4989. A shared device does not prove common ownership or fraud.",
      "references": [
        "s1",
        "r1",
        "f3",
        "f5"
      ]
    },
    {
      "id": "h2",
      "statement": "The A-9895 alert (six identical 2500 credits, partial forwarding, no device linkage) may be benign collective payments such as a shared bill or group collection, and possibly a false positive of the fan-in rule. The data does not establish this.",
      "references": [
        "i2",
        "r2",
        "x1",
        "f4"
      ]
    },
    {
      "id": "h3",
      "statement": "The small shortfall at each hop on the A-9278 route (about 3000–4000 per hop) could be fees or skimmed amounts kept by intermediaries. This is an interpretation only.",
      "references": [
        "e07",
        "e08",
        "e09",
        "e14",
        "e15",
        "e16"
      ]
    }
  ],
