        "X12"
      ]
    }
  ],
  "hypotheses": [
    {
      "id": "H1",
      "statement": "D-568 being used to send from A-9278, A-5092 and A-2897 may mean one party controls all three accounts, moving pooled funds through them to A-4989 (layering). The data records only device use, not ownership or identity.",
      "references": [
        "S1",
        "R1"
      ]
    },
    {
      "id": "H2",
      "statement": "The six identical 2500 credits to A-9895 from six senders on six devices may be a benign collection (for example a shared bill or group payment) rather than mule activity. They may also be a low-value test. Nothing in the data settles which.",
      "references": [
        "I2",
        "R2",
        "X1"
      ]
    },
    {
      "id": "H3",
      "statement": "The small amount kept back at each hop on A-9278's route (for example 138000 -> 135000 -> 132000) may be fees or cuts taken by intermediaries. That reading is not established.",
      "references": [
        "E7",
        "E8",
        "E9",
        "E10",
        "E11",
        "E12"
      ]
    }
  ],
