  "hypotheses": [
    {
      "id": "H1",
      "statement": "For A-37573, a single device sending every onward transfer across four accounts, in two identical account sequences, could mean one party operates those accounts (a possible mule chain). This is an interpretation; a shared device can also come from a shared or managed terminal.",
      "references": [
        "S1",
        "P1",
        "P2"
      ]
    },
    {
      "id": "H2",
      "statement": "For A-83577, the onward transfer of 172,000 against a fan-in total of 174,500, followed by quick successive debits of slightly smaller amounts, could mean collected credits were forwarded along the route. The data records only timing and amounts, not that the same funds moved.",
      "references": [
        "I5",
        "E9",
        "E10",
        "E11",
        "E12",
        "E13",
        "P3"
      ]
    },
    {
      "id": "H3",
      "statement": "For A-10859, the branching to two end accounts with devices shared between A-10859 and A-78340 could reflect splitting under common control. Unverified.",
      "references": [
        "R3",
        "S3"
      ]
    },
    {
      "id": "H4",
      "statement": "A-85921 (six equal 2,500 credits) and A-28137 (small credits with no onward link) may be benign collection patterns, such as group payments or merchant-like receipts, that met the fan-in threshold. Not established.",
      "references": [
        "I2",
        "I4",
        "R6"
      ]
    }
  ],
