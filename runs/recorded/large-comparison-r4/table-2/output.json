  "hypotheses": [
    {
      "id": "H1",
      "statement": "A-37573's path accounts (A-37573, A-38045, A-93288, A-63022) may be operated by a single party: they all sent from D-45880, in quick succession, with slightly decreasing amounts. This would fit a layering pattern, but the data shows only device use and timing, not who controls the accounts or whether the same funds moved.",
      "references": [
        "S2",
        "R4",
        "P41",
        "P42"
      ]
    },
    {
      "id": "H2",
      "statement": "A-83577's sequence may be a relay pattern. D-40018 is shared by non-adjacent accounts A-83094 and A-14799, and also by off-path A-34114, which raises the possibility of a wider linked set. This is not established.",
      "references": [
        "S3",
        "R5",
        "P51"
      ]
    },
    {
      "id": "H3",
      "statement": "A-10859 and A-78340 may be controlled together, since both sent from D-79802. Not established.",
      "references": [
        "S1",
        "R1"
      ]
    },
    {
      "id": "H4",
      "statement": "A-28137's fan-in (small amounts, no onward links) and A-85921's (six identical 2500 transfers) could be ordinary collection activity, such as shared bills or a small merchant. The data cannot tell this apart from other explanations.",
      "references": [
        "R3",
        "I3",
        "I6"
      ]
    }
  ],
