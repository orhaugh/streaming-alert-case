  "hypotheses": [
    {
      "id": "H1",
      "statement": "Alert 1 matches a collection-and-layering pattern: funds gathered at A-9278, then moved quickly through A-5092 and A-2897 to A-4989, with every hop sent from one device. That could mean one party controls A-9278, A-5092 and A-2897. A shared device does not prove common ownership, identity or fraud.",
      "references": [
        "sd-568",
        "r-9278",
        "p-9278-a",
        "p-9278-d"
      ]
    },
    {
      "id": "H2",
      "statement": "Alert 2 may be benign or low risk, for example identical small payments such as a split bill, subscription or collection, followed by one outgoing payment. It may also be a smaller mule pattern. The data does not decide between these.",
      "references": [
        "i-9895",
        "r-9895",
        "ab-route-9895",
        "ab-T0035",
        "ab-T0036",
        "ab-T0037"
      ]
    },
    {
      "id": "H3",
      "statement": "In alert 1, each onward hop is slightly smaller than the one before (138000, 135000, 132000; 210000, 206000, 202000). One reading is that a fee or skim is kept at each hop. This is an interpretation only.",
      "references": [
        "e-T0007",
        "e-T0008",
        "e-T0009",
        "e-T0014",
        "e-T0015",
        "e-T0016"
      ]
    }
  ],
