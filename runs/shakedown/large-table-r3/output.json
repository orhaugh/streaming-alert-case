      ]
    }
  ],
  "hypotheses": [
    {
      "id": "H1",
      "statement": "A-37573 may be a layering chain controlled from one place: four accounts send from the same device D-45880, and each hop takes roughly 3–5 minutes with small amount decreases. The data does not establish that one party controls these accounts, only that the device was recorded for their transfers.",
      "references": [
        "F2",
        "C-dev-45880",
        "C-reach-37573"
      ]
    },
    {
      "id": "H2",
      "statement": "A-83577 may be multi-hop layering. Its 5-hop route has one device reused at hops 3 and 5 (D-40018), which could point to a common operator behind A-83094 and A-14799. The device also appears on unrelated account A-34114, so it could instead be a shared or public device.",
      "references": [
        "F3",
        "C-dev-40018-route",
        "C-dev-40018-all"
      ]
    },
    {
      "id": "H3",
      "statement": "A-10859 and A-78340 may be linked, since both used D-79802, and the money was split across two resting accounts. This could be dispersal, or ordinary business between related accounts.",
      "references": [
        "F4",
        "C-dev-79802"
      ]
    },
    {
      "id": "H4",
      "statement": "A-20636, A-85921 and A-28137 may be benign aggregation, for example collections or shared bills: small amounts (A-85921 got identical 2,500 payments), shallow or no onward movement, and no device sharing on the route. Under the recorded relationships they are weaker candidates than A-37573, A-83577 and A-10859, but the data does not show any of them to be legitimate.",
      "references": [
        "F5",
        "F6",
        "F7"
      ]
    }
  ],
  "unresolved": [
    {
      "id": "U1",
      "question": "Who owns or controls the accounts and devices? A shared device record does not establish identity, ownership or common control.",
      "references": [
        "C-dev-45880",
        "C-dev-40018-route",
        "C-dev-79802",
        "C-dev-30793"
      ]
    },
    {
      "id": "U2",
      "question": "What happened to funds at the resting accounts (A-54215, A-39382, A-92332, A-85287, A-36729, A-10758) after this bounded replay, or through transfers more than 30 minutes apart, which onward links do not capture?",
      "references": [
        "C-reach-37573",
        "C-reach-83577",
        "C-reach-10859",
        "C-reach-20636",
        "C-reach-85921"
      ]
    },
    {
      "id": "U3",
      "question": "Do the onward links mean the same money moved? Onward links only pair a credit with a later debit within 30 minutes. They do not prove that the funds were the same or that one transfer caused the other.",
      "references": [
        "F8"
      ]
    },
    {
      "id": "U4",
      "question": "Is A-28137's later transfer T018852 (21,000 to A-87539, about 2 h after the fan-in) related to the incoming funds? The run's link rule does not relate it.",
      "references": [
        "C-ev-T018852",
        "C-reach-28137"
      ]
    }
  ],
