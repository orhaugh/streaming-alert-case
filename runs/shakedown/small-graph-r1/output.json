  "hypotheses": [
    {
      "id": "H1",
      "statement": "A-9278, A-5092 and A-2897 may be operated by the same person or group, because one device (D-568) sent every onward transfer among them within minutes. The data records shared device use only; it does not establish ownership or control.",
      "references": [
        "s1",
        "e07",
        "e08",
        "e09",
        "e14",
        "e15",
        "e16"
      ]
    },
    {
      "id": "H2",
      "statement": "Alert 1's pattern (many senders, consolidation, rapid multi-hop forwarding with small decrements, ending at A-4989) fits collection and layering, e.g. a money-mule chain. It is equally possible it has a legitimate explanation; nothing recorded establishes fraud.",
      "references": [
        "i1",
        "r1",
        "p1",
        "p4"
      ]
    },
    {
      "id": "H3",
      "statement": "Alert 2's six equal 2500 credits and single partial forward to A-1415 may reflect a benign group collection (e.g. equal shares) rather than laundering. This is not established.",
      "references": [
        "i2",
        "p7",
        "a1"
      ]
    }
  ],
