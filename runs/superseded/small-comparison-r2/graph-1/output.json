    {
      "id": "F1",
      "statement": "Alert 1, fan_in:A-9278:1794301200000: account A-9278 received 6 transfers from 6 distinct senders in window 1794301200000–1794304800000, totalling 357000 minor units. The contributing transfers are T0002, T0003, T0006, T0010, T0011 and T0012. Amounts vary from 38000 to 89000, and each sender used a different device.",
      "claim_ids": [
        "I1",
        "E1",
        "E2",
        "E3",
        "E4",
        "E5",
        "E6"
      ]
    },
    {
      "id": "F2",
      "statement": "Alert 2, fan_in:A-9895:1794319200000: account A-9895 received 6 transfers from 6 distinct senders in window 1794319200000–1794322800000, totalling 15000 minor units. The contributing transfers are T0035 to T0040. Each is exactly 2500, and each was sent from a different device.",
