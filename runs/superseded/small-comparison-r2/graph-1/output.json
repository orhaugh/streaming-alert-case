        "fan_in:A-9278:1794301200000",
        "D-568",
        "A-9278",
        "A-5092",
        "A-2897",
        "A-4989",
        "T0007",
        "T0014"
      ]
    },
    {
      "id": "H2",
      "statement": "Alert 2 could be benign, for example many small identical payments such as a collection or a split bill, followed by an ordinary later payment. The onward link to T0041 is a timing link only (14000 sent after 7500 of linked credits) and does not show that those specific funds moved on.",
      "references": [
        "fan_in:A-9895:1794319200000",
        "T0041",
        "A-1415"
      ]
    },
